!data/raw/*_pstats_2023.csv
!data/raw/*_pstats_2024.csv
!data/raw/*_pstats_2025.csv
!data/raw/*_pstats_2026.csv
data/games_*.csv
__pycache__/
.pytest_cache/
data/raw/*.part
